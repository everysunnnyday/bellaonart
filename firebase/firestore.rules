rules_version = '2';
// =========================================================
// 벨라온 온라인 클래스 — 보안 규칙 (설계: docs/01_수강시스템-설계.md §3·§5)
// 화면에서 버튼을 숨기는 것과 별개로, "데이터를 줄지 말지"는 여기서 최종 판정한다.
// 운영 숫자(30일·10일·98% 등)는 config/policy 문서가 유일한 기준 — 여기에 숫자를 적지 않는다.
// =========================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function cfg(name) { return get(/databases/$(database)/documents/config/$(name)).data; }

    // 관리자 = config/admins.emails 에 있는 (구글이 확인한) 이메일
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in cfg('admins').emails;
    }

    function enrPath(u, cid) { return /databases/$(database)/documents/enrollments/$(u + '_' + cid); }

    // 유효 수강권 = (이메일 인증된 회원) + 상태 active + 지금이 시작~종료 사이 (종료일 null = 기간 제한 없음)
    // 구글 회원은 항상 인증됨 · 이메일 가입 회원은 인증 메일 링크를 눌러야 함
    function hasValid(cid) {
      let p = enrPath(uid(), cid);
      return signedIn() && request.auth.token.email_verified == true && exists(p)
        && get(p).data.status == 'active'
        && get(p).data.startAt <= request.time
        && (get(p).data.get('endAt', null) == null || request.time <= get(p).data.endAt);
    }

    // 회원이 직접 받는 무료 수강권의 시작 = 오늘 0시(한국시간) — 지금 이전이고 하루 안쪽이어야 함(과거로 당겨 쓰기 방지)
    function freshStart(t) {
      return t is timestamp && t <= request.time && t > request.time - duration.value(1, 'd');
    }

    // 무료 강좌 = 공개 + 수강료 "0"·"0원"·"무료" (2026-10-04)
    // ⚠ js/core.js FREE_PRICE_RE 와 같은 규칙 — 바꾸면 둘 다
    function isFreeCourse(cid) {
      let c = get(/databases/$(database)/documents/courses/$(cid)).data;
      return c.get('published', false) == true && c.get('priceLabel', '').matches('^ *(0+ *원?|무료) *$');
    }

    // ---------- 설정 ----------
    match /config/admins {
      allow read: if isAdmin();      // 화면은 "읽힘 = 관리자"로 판정
      allow write: if false;         // Firebase 콘솔에서만 수정
    }
    match /config/policy {
      allow read: if true;
      // 처음 한 번만 관리자 페이지가 기본값으로 생성. 이후 변경은 콘솔에서만.
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['defaultDays','remindDays','extendDays','completeRatio','maxRate'])
        && request.resource.data.defaultDays is int && request.resource.data.remindDays is int
        && request.resource.data.extendDays is int
        && request.resource.data.completeRatio is number && request.resource.data.maxRate is number;
      allow update, delete: if false;
    }

    // ---------- 회원 ----------
    match /users/{u} {
      allow get: if signedIn() && (u == uid() || isAdmin());
      allow list: if isAdmin();
      allow create, update: if signedIn() && u == uid()
        && request.resource.data.keys().hasOnly(['name','email','photoURL','provider','phone','createdAt','lastLoginAt'])
        && request.resource.data.email == request.auth.token.email
        && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 20));
      allow delete: if signedIn() && u == uid();   // 회원 탈퇴(마이페이지) — 본인만
    }

    // ---------- 강좌 ----------
    match /courses/{cid} {
      // 공개 강좌는 누구나 · 비공개로 내린 강좌도 수강권(기간 무관)이 있던 회원은 [내 강의실]에서 볼 수 있게
      allow read: if resource.data.published == true || isAdmin()
        || (signedIn() && exists(enrPath(uid(), cid)));
      allow create, update: if isAdmin() && cid.matches('^[a-z0-9-]{2,40}$');
      allow delete: if false;        // 강좌는 지우지 않고 '비공개'로 내린다

      // 차시 목차(제목·길이·순서) — 강좌를 볼 수 있는 사람은 누구나(상세 페이지 목차)
      // ⚠ 영상 주소는 여기에 넣을 수 없다(칸 제한) → 아래 videos 에만
      match /lessons/{lid} {
        allow read: if get(/databases/$(database)/documents/courses/$(cid)).data.published == true
          || isAdmin() || (signedIn() && exists(enrPath(uid(), cid)));
        allow create, update: if isAdmin()
          && request.resource.data.keys().hasOnly(['title','durationSec','order','createdAt']);
        allow delete: if isAdmin();
      }
      // 차시 영상 주소(유튜브 ID) — 관리자 + 유효 수강권 보유자만. 문서 ID = 차시 ID
      match /videos/{lid} {
        allow read: if isAdmin() || hasValid(cid);
        allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['youtubeId']);
        allow delete: if isAdmin();
      }
    }

    // ---------- 수강 코드 (문서 ID = 코드, 소문자) ----------
    // 코드 확인·수강권 생성·사용 횟수 증가는 서버 함수(redeemCode)만 한다 — 회원은 읽지도 못함
    match /codes/{code} {
      allow read: if isAdmin();
      allow create: if isAdmin() && code.matches('^[a-z0-9-]{4,30}$')
        && request.resource.data.keys().hasOnly(['courseId','maxUses','expiresAt','active','memo','usedCount','createdBy','createdAt'])
        && request.resource.data.usedCount == 0;
      // 관리자는 중지/재개·메모·인원·마감만 바꾼다(사용 횟수·강좌는 못 바꿈)
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','memo','maxUses','expiresAt']);
      allow delete: if false;        // 지우지 않고 '중지'
      match /uses/{u} {
        allow read: if isAdmin();
        allow write: if false;       // 서버 함수만
      }
    }

    // ---------- 수강권 (문서 ID = 회원uid_코스ID) ----------
    match /enrollments/{eid} {
      allow get: if signedIn() && (eid.split('_')[0] == uid() || isAdmin());
      allow list: if isAdmin() || (signedIn() && resource.data.uid == uid());

      allow create, update: if isAdmin()
        && eid == request.resource.data.uid + '_' + request.resource.data.courseId;

      // 무료 강좌(2026-10-04): 인증된 회원이 본인 수강권을 직접 받는다 — 지금 시작 · 기간 제한 없음(endAt null) · 정해진 칸·값만
      // (강좌 상세를 열면 화면이 자동으로 만든다 — js/class-watch.js claimFree)
      allow create: if signedIn() && request.auth.token.email_verified == true
        && request.resource.data.uid == uid()
        && eid == uid() + '_' + request.resource.data.courseId
        && isFreeCourse(request.resource.data.courseId)
        && request.resource.data.keys().hasOnly(['uid','courseId','status','startAt','endAt','extendedCount','source','grantedAt'])
        && request.resource.data.status == 'active'
        && freshStart(request.resource.data.startAt)
        && request.resource.data.endAt == null
        && request.resource.data.extendedCount == 0
        && request.resource.data.source == 'free'
        && request.resource.data.grantedAt == request.time;

      // 무료 강좌에 이미 있던 본인 수강권(기간제·만료 포함, 회수 제외)을 기간 제한 없음으로 바꾼다
      // 바뀌는 칸 = 종료일(null) · 바꾼 시각 · 시작일(그대로 또는 오늘 0시 — 시작 전이던 것을 바로 열 때)
      allow update: if signedIn() && resource.data.uid == uid()
        && request.auth.token.email_verified == true
        && resource.data.status == 'active'
        && isFreeCourse(resource.data.courseId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['endAt','startAt','freeAt'])
        && request.resource.data.endAt == null
        && request.resource.data.freeAt == request.time
        && (request.resource.data.startAt == resource.data.startAt || freshStart(request.resource.data.startAt));

      // 회원 본인 연장 1회(D16·D17): 바뀌는 칸은 3개뿐, 종료일 정확히 +연장일수,
      // 수강 중(시작 ~ 종료 시각)이면 언제든 — js/core.js canExtend 와 같은 조건
      allow update: if signedIn() && resource.data.uid == uid()
        && request.auth.token.email_verified == true
        && resource.data.status == 'active'
        && resource.data.extendedCount == 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['endAt','extendedCount','extendedAt'])
        && request.resource.data.extendedCount == 1
        && request.resource.data.extendedAt == request.time
        && request.resource.data.endAt == resource.data.endAt + duration.value(cfg('policy').extendDays, 'd')
        && resource.data.startAt <= request.time
        && request.time <= resource.data.endAt;

      allow delete: if false;        // 지우지 않고 status 'revoked' 로 회수
    }

    // ---------- 진도 (문서 ID = 회원uid_코스ID) ----------
    match /progress/{pid} {
      allow get: if signedIn() && (pid.split('_')[0] == uid() || isAdmin());
      allow list: if isAdmin();
      allow create, update: if signedIn()
        && pid == uid() + '_' + request.resource.data.courseId
        && request.resource.data.uid == uid()
        && request.resource.data.keys().hasOnly(['uid','courseId','lessons','completedAt','updatedAt'])
        && hasValid(request.resource.data.courseId);
      allow delete: if false;
    }
  }
}
